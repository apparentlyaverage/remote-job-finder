# Copy this file to .env (same folder) and fill in the real value.
# .env is already in .gitignore -- it will never be committed.

# Gmail App Password (NOT your normal Gmail password).
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for your Google account).
GMAIL_APP_PASSWORD=paste-the-16-character-app-password-here

# The Gmail address that SENDS the report (usually the same as the recipient).
GMAIL_SENDER=uthando.mkwanazi@gmail.com

# Where the report gets sent.
GMAIL_RECIPIENT=uthando.mkwanazi@gmail.com
